model Language {
  // Normal Fields
  name      String
  key       String    @id
  file      String
  frontFile String    @map("front_file")
  // default Fields
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  sessions Session[]

  @@index([name], map: "languages_name")
  @@index([deletedAt], map: "languages_deleted_at")
  @@map("languages")
}

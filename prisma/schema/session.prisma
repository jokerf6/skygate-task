model Session {
  id               String      @id @default(uuid())
  jti              String      @unique @default(uuid())
  ipAddress        String?     @map("ip_address") @db.Text
  userId           String?     @map("user_id")
  fcmToken         String?     @map("fcm_token") @db.VarChar(255)
  socketId         String?     @map("socket_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  invalidatedAt    DateTime?   @map("invalidated_at")
  type             SessionType @default(ACCESS)
  refreshParentJti String?     @map("refresh_parent_jti")

  User User? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  Language   Language? @relation(fields: [languageId], references: [key], onDelete: SetNull, onUpdate: Cascade)
  languageId String?   @map("language_id")

  @@index([userId], map: "userId")
  @@index([languageId], map: "sessions_language_id")
  @@index([type, createdAt], map: "sessions_type_created_at")
  @@index([refreshParentJti], map: "sessions_refresh_parent_jti")
  @@index([invalidatedAt], map: "sessions_invalidated_at")
  @@map("sessions")
}

model Devices {
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @map("user_id")

  deviceId String @map("device_id")

  createdAt DateTime  @default(now()) @map("created_at")
  lastLogin DateTime? @map("last_login")

  @@unique([userId, deviceId])
  @@index([userId, deviceId], map: "user_device_id")
  @@index([lastLogin], map: "devices_last_login")
  @@map("devices")
}

enum SessionType {
  ACCESS
  REFRESH
  VERIFY
  VISITOR
  PASSWORD_RESET
}

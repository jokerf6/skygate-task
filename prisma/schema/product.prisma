model Product {
  id          String    @id @unique @default(uuid())
  sku         String    @unique
  name        Json      @db.Json
  description Json?     @db.Json
  price       Float
  stock       Int
  image       String    @default("uploads/default.png")
  // default columns
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  OrderItems OrderItem[]

  @@index([name], map: "products_name")
  @@index([description], map: "products_description")
  @@index([stock], map: "products_stock")
  @@index([deletedAt], map: "products_deleted_at")
  @@map("products")
}

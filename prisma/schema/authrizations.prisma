model Role {
  id        String    @id @default(uuid())
  name      Json?     @db.Json
  roleKey   String    @unique @map("key")
  // default columns
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  // relations
  Users                      User[]
  RolePermission             RolePermission[]
  SystemReceiverNotification SystemNotification[] @relation("SystemReceiverNotification")

  @@index([deletedAt], map: "roles_deleted_at")
  @@index([createdAt], map: "roles_created_at")
  @@map("roles")
}

model Permission {
  id        String    @id @default(uuid())
  name      Json?     @db.Json
  method    String
  prefix    String
  default   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  RolePermission RolePermission[]

  @@unique([prefix, method])
  @@index([default], map: "permissions_default")
  @@index([deletedAt], map: "permissions_deleted_at")
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  // relations
  Role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId], map: "role_permissions_role_id")
  @@index([permissionId], map: "role_permissions_permission_id")
  @@map("role_permissions")
}

enum RoleKey {
  ADMIN
  CUSTOMER
}

model Order {
  id             String      @id @default(uuid())
  invoiceNumber  String?     @unique @map("invoice_number")
  idempotencyKey String      @unique @map("idempotency_key")
  status         OrderStatus @default(PENDING)
  total          Float       @default(0)

  // relations
  User   User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId String      @map("user_id")
  Items  OrderItem[]

  // default columns
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId, createdAt], map: "orders_user_created_at")
  @@index([status, createdAt], map: "orders_status_created_at")
  @@index([deletedAt], map: "orders_deleted_at")
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  productId       String  @map("product_id")
  productSnapshot Json    @map("product_snapshot")
  quantity        Int
  // relations
  Order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // default columns
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([orderId, productId], map: "order_items_order_id_product_id")
  @@index([orderId], map: "order_items_order_id")
  @@index([productId], map: "order_items_product_id")
  @@index([deletedAt], map: "order_items_deleted_at")
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}
